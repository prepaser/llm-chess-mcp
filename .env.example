# Lichess opening explorer (optional; explorer tools disabled if unset)
# Generate at https://lichess.org/account/oauth/token/create
LICHESS_TOKEN=

# Optional Maia3 model override (the bundled manifest is used by default).
# MAIA3_MODEL=5m

# Analysis engines: both (default) | stockfish | lc0
# ENGINE_MODE=both

# Stockfish flavor: lite-single (default, ~7MB) | single-lite | lite | single | full | asm
# STOCKFISH_FLAVOR=lite-single

# Optional HTTP Bearer token for a private, single-user server.
# HTTP_BEARER=replace-with-a-random-token
